<Ui xmlns="http://www.blizzard.com/wow/ui/">
	<!-- Adapted from Shortest Path Forever by cjber, GPL-3.0-or-later. -->
	<Frame name="MapTweaksDockPinTemplate" inherits="BaseHighlightableMapPoiPinTemplate"
		mixin="MapTweaksDockPinMixin" enableMouse="true" virtual="true">
		<Layers>
			<Layer level="BACKGROUND">
				<!-- Square glow, 18 past every side of the pin. -->
				<Texture parentKey="Glow" atlas="UI-QuestPoi-OuterGlow" hidden="true">
					<Anchors>
						<Anchor point="TOPLEFT" x="-18" y="18"/>
						<Anchor point="BOTTOMRIGHT" x="18" y="-18"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
	</Frame>
	<Frame name="MapTweaksPingPinTemplate" inherits="MapPinPingTemplate" virtual="true"/>
	<Frame name="MapTweaksRoutePinTemplate" mixin="MapTweaksRoutePinMixin" virtual="true"/>
</Ui>
